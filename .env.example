# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. .env is gitignored.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=3000

# PostgreSQL
# Option A — a full connection string (managed providers such as Neon/Supabase/RDS).
# When set, it takes precedence over the discrete DB_* fields below. SSL is enabled
# automatically if the URL contains `sslmode=require`.
# DB_URL=postgresql://user:password@host/dbname?sslmode=require
#
# Option B — discrete fields, for a local Postgres. Used only when DB_URL is unset.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vehicle_rental
# Set to true for a managed provider if you use the discrete fields instead of DB_URL.
DB_SSL=false

# Knex connection pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# Auth — generate a real secret, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_me_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Uploads (relative to the project root)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Rate limiting on POST /auth/login
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
